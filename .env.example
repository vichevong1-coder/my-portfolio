# Cloudflare R2 S3 API Endpoint & Credentials
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_R2_BUCKET_NAME=portfolio-media
CLOUDFLARE_R2_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_API_URL=https://<account_id>.r2.cloudflarestorage.com/<bucket_name>
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Public access URL (R2.dev subdomain or custom domain like https://media.yourdomain.com)
NEXT_PUBLIC_R2_URL=
